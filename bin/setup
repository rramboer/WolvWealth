#!/bin/bash
# Install WolvWealth into the global Python interpreter (per-user site) and
# fetch the Node deps for the website build. No venv on purpose: the
# optimizer and API must be importable from any directory on this device,
# including by AI agents spawned outside the repo.

set -Eeuo pipefail

echo "Installing Python package (editable, user site)..."
pip install --user --break-system-packages -e ".[dev]"

if command -v npm >/dev/null; then
  echo "Installing Node dependencies (website CSS/JS build)..."
  npm install
else
  echo "npm not found; skipping website build deps (the JSON API works without them)."
fi

# Clean up Python caches
find . -type d -name "__pycache__" -not -path '*/node_modules/*' -exec rm -r {} +

echo "Setup complete."
