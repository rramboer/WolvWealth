#!/bin/bash
# wolvwealth db - manage the development SQLite database.
#
# Uses the Python stdlib sqlite3 module, so no sqlite3 CLI is required.

set -Eeuo pipefail

DB_FILE="var/wolvwealth.sqlite3"
PYTHON="${PYTHON:-python3}"
if [ -x ".venv/bin/python" ]; then
  PYTHON=".venv/bin/python"
fi

usage() {
  echo "Usage: $0 (create|destroy|reset|dump)"
}

run_sql_scripts() {
  "$PYTHON" - "$DB_FILE" "$@" <<'EOF'
import sqlite3
import sys

db, *scripts = sys.argv[1:]
connection = sqlite3.connect(db)
for script in scripts:
    with open(script, encoding="utf-8") as f:
        connection.executescript(f.read())
connection.commit()
connection.close()
EOF
}

dump_table() {
  "$PYTHON" - "$DB_FILE" "$1" <<'EOF'
import sqlite3
import sys

db, table = sys.argv[1:]
connection = sqlite3.connect(db)
connection.row_factory = sqlite3.Row
for row in connection.execute(f"SELECT * FROM {table}"):
    print(dict(row))
connection.close()
EOF
}

if [ $# -ne 1 ]; then
  usage
  exit 1
fi

case $1 in
  "create")
    if [ -e "$DB_FILE" ]; then
      echo "Database already exists."
    else
      mkdir -p var
      run_sql_scripts sql/schema.sql sql/data.sql
      echo "Database created."
    fi
    ;;

  "destroy")
    rm -rf "$DB_FILE" var/uploads
    echo "Database destroyed."
    ;;

  "reset")
    rm -rf "$DB_FILE" var/uploads
    mkdir -p var
    run_sql_scripts sql/schema.sql sql/data.sql
    echo "Database destroyed and recreated. All data erased."
    ;;

  "dump")
    echo "Printing Users:"
    dump_table users
    echo ""
    echo "Printing Tokens:"
    dump_table tokens
    ;;

  *)
    usage
    exit 1
    ;;
esac
