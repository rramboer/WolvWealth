#!/bin/bash
# Manage the local workspace database (var/wolvwealth.sqlite3).
# Uses Python's sqlite3 module, so the sqlite3 CLI is not required.

set -Eeuo pipefail

usage() {
  echo "Usage: $0 (create|destroy|reset|dump)"
}

db_path() {
  python3 -c 'from wolvwealth import config; print(config.DATABASE_FILENAME)'
}

create_db() {
  python3 - <<'PY'
import sqlite3
from wolvwealth import config

db = sqlite3.connect(config.DATABASE_FILENAME)
db.executescript((config.SQL_DIR / "schema.sql").read_text())
db.executescript((config.SQL_DIR / "seed.sql").read_text())
db.commit()
db.close()
PY
}

dump_db() {
  python3 - <<'PY'
import sqlite3
from wolvwealth import config

db = sqlite3.connect(config.DATABASE_FILENAME)
db.row_factory = sqlite3.Row
for table in ("workspaces", "portfolios", "holdings"):
    print(f"== {table} ==")
    for row in db.execute(f"SELECT * FROM {table}"):
        print(dict(row))
    print()
PY
}

if [ $# -ne 1 ]; then
  usage
  exit 1
fi

case $1 in
  "create")
    if [ -e "$(db_path)" ]; then
      echo "Database already exists."
    else
      create_db
      echo "Database created."
    fi
    ;;
  "destroy")
    rm -f "$(db_path)"
    echo "Database destroyed."
    ;;
  "reset")
    rm -f "$(db_path)"
    create_db
    echo "Database destroyed and recreated. All workspaces erased."
    ;;
  "dump")
    dump_db
    ;;
  *)
    usage
    exit 1
    ;;
esac
