{
  "name": "wolvwealth",
  "version": "1.2.0",
  "private": true,
  "description": "WolvWealth web frontend (React optimizer + backtest dashboard, Tailwind styles)",
  "author": "WolvWealth Team",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -o wolvwealth/static/css/output.css --minify",
    "build:js": "vite build",
    "watch:css": "tailwindcss -o wolvwealth/static/css/output.css --watch",
    "watch:js": "vite build --watch --mode development",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
