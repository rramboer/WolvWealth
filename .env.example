# WolvWealth environment configuration (copy to .env and edit; never commit .env)

# REQUIRED in production. Signs Flask session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
WOLVWEALTH_SECRET_KEY=

# Optional: path to the SQLite database (default: var/wolvwealth.sqlite3)
# WOLVWEALTH_DATABASE=/path/to/wolvwealth.sqlite3

# Optional: directory containing ticker_universe.csv and historical_prices.csv
# (default: the repository root)
# WOLVWEALTH_DATA_DIR=/path/to/data

# Optional: path to an additional Flask settings file
# WOLVWEALTH_SETTINGS=/etc/wolvwealth.cfg

# Gunicorn (production server) tuning
# GUNICORN_PROCESSES=1
# GUNICORN_THREADS=4
# GUNICORN_BIND=0.0.0.0:8000
# Comma-separated IPs of trusted reverse proxies for X-Forwarded-* headers
# GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
