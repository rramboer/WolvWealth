# WolvWealth environment configuration (copy to .env and edit; never commit .env)

# REQUIRED in production. Signs Flask session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
WOLVWEALTH_SECRET_KEY=

# Optional: path to the SQLite database (default: var/wolvwealth.sqlite3)
# WOLVWEALTH_DATABASE=/path/to/wolvwealth.sqlite3

# Optional: directory containing ticker_universe.csv and historical_prices.csv
# (default: the repository root)
# WOLVWEALTH_DATA_DIR=/path/to/data

# Optional: path to an additional Flask settings file
# WOLVWEALTH_SETTINGS=/etc/wolvwealth.cfg

# Backtest API (/api/backtest/) limits per request, and the in-memory report cache size
# WOLVWEALTH_BACKTEST_MAX_REBALANCES=120
# WOLVWEALTH_BACKTEST_MAX_UNIVERSE_SIZE=100
# WOLVWEALTH_BACKTEST_CACHE_SIZE=64
# Background job pool for backtests (jobs live in memory: keep GUNICORN_PROCESSES=1)
# WOLVWEALTH_BACKTEST_MAX_WORKERS=2
# WOLVWEALTH_BACKTEST_MAX_PENDING_JOBS=20
# WOLVWEALTH_BACKTEST_MAX_JOBS_PER_USER=2
# WOLVWEALTH_BACKTEST_JOB_TTL_SECONDS=900

# Rate limiting (see README "Rate limiting").
# Number of reverse proxies in front of the app. Set to 1 behind nginx, or every
# client shares 127.0.0.1's limits. Leave 0 when gunicorn is exposed directly.
# WOLVWEALTH_TRUSTED_PROXIES=0
# Counter storage: memory:// is per process; use redis:// with several workers.
# WOLVWEALTH_RATELIMIT_STORAGE_URI=memory://
# WOLVWEALTH_RATELIMIT_ENABLED=true
# Individual limits ("N per second|minute|hour|day", ";"-separated):
# WOLVWEALTH_RATELIMIT_SITE_PER_IP=600 per minute
# WOLVWEALTH_RATELIMIT_API_PER_IP=300 per minute
# WOLVWEALTH_RATELIMIT_OPTIMIZE_PER_CALLER=20 per minute;200 per hour
# WOLVWEALTH_RATELIMIT_BACKTEST_START_PER_CALLER=10 per minute;60 per hour
# WOLVWEALTH_RATELIMIT_BACKTEST_STATUS_PER_CALLER=180 per minute
# WOLVWEALTH_RATELIMIT_ACCOUNT_PER_IP=30 per minute
# WOLVWEALTH_RATELIMIT_LOGIN_PER_IP=10 per minute;50 per hour
# WOLVWEALTH_RATELIMIT_LOGIN_PER_USERNAME=20 per hour
# WOLVWEALTH_RATELIMIT_REGISTER_PER_IP=5 per hour

# Gunicorn (production server) tuning
# GUNICORN_PROCESSES=1
# GUNICORN_THREADS=4
# GUNICORN_BIND=0.0.0.0:8000
# Comma-separated IPs of trusted reverse proxies for X-Forwarded-* headers
# GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
